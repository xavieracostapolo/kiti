{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Permisos mínimos para la ventana principal",
  "windows": ["main"],
  "permissions": [
    "allow-subscribe",
    "allow-kill-agent",
    "allow-report-ui-metrics",
    "allow-set-debug-stream",
    "allow-ui-log",
    "allow-launch-agent",
    "allow-list-terminals",
    "allow-attach-terminal",
    "allow-terminal-input",
    "allow-terminal-resize",
    "allow-list-conversations",
    "allow-resume-conversation",
    "allow-hide-conversation"
  ]
}
